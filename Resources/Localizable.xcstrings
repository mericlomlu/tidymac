            "value": "Hızlı Tarama"
          }
        }
      }
    },
    "Quick Scan checks caches, logs, big files and browser leftovers. Nothing is removed until you review it.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hızlı Tarama önbellekleri, günlükleri, büyük dosyaları ve tarayıcı kalıntılarını denetler. Siz incelemeden hiçbir şey kaldırılmaz."
          }
        }
      }
    },
    "Some folders could not be read, so these results are incomplete.": {
      "localizations": {
