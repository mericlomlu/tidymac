        }
      }
    },
    "%lld copies. At least one copy of every file is always kept.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld kopya. Her dosyanın en az bir kopyası her zaman saklanır."
