      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deneme modu"
          }
        }
      }
    },
    "Dry run is off. Cleans move items to the Trash.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deneme modu kapalı. Temizlikler öğeleri Çöp Sepeti'ne taşır."
          }
        }
      }
    },
    "Dry run is off. Items move to the Trash after you confirm.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deneme modu kapalı. Öğeler siz onayladıktan sonra Çöp Sepeti'ne taşınır."
          }
        }
      }
    },
    "Dry run is on, so this only previews.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deneme modu açık, bu yüzden yalnızca önizleme yapılır."
          }
        }
      }
    },
    "Dry run is on. Cleans only preview.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deneme modu açık. Temizlikler yalnızca önizlenir."
          }
        }
      }
    },
    "Dry run is on. Scans and cleans only preview, nothing is deleted.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deneme modu açık. Taramalar ve temizlikler yalnızca önizlenir, hiçbir şey silinmez."
          }
        }
      }
