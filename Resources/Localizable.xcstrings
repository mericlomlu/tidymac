      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vazgeç"
          }
        }
      }
    },
    "Changes apply to the next scan.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değişiklikler bir sonraki taramada geçerli olur."
          }
        }
      }
    },
    "Checking %@. This only reads, nothing is changed.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Denetleniyor: %@. Yalnızca okunur, hiçbir şey değiştirilmez."
          }
        }
      }
    },
    "Checking what would be removed…": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nelerin kaldırılacağı denetleniyor…"
          }
        }
      }
    },
    "Clean": {
