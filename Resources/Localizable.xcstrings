    "Background items that start automatically. Removing a user item moves it to the Trash and stops it. System items are read-only.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatik olarak başlayan arka plan öğeleri. Bir kullanıcı öğesini kaldırmak onu Çöp Sepeti'ne taşır ve durdurur. Sistem öğeleri salt okunurdur."
          }
        }
      }
    },
    "Battery": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pil"
          }
        }
      }
    },
