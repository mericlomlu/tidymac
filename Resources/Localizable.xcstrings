    "The agent could not be stopped, so it keeps running until you log out.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aracı durdurulamadı, bu yüzden oturumu kapatana kadar çalışmaya devam eder."
          }
        }
      }
    },
    "The app and the files it left behind. The app's own documents and loose matches are marked Review and start unticked. Quit the app before removing it.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama ve geride bıraktığı dosyalar. Uygulamanın kendi belgeleri ve kesin olmayan eşleşmeler İncele olarak işaretlenir ve işaretsiz başlar. Kaldırmadan önce uygulamadan çıkın."
          }
        }
      }
    },
    "The log file could not be written.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günlük dosyası yazılamadı."
          }
