    "Caches are ticked. History and cookies need your say-so.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önbellekler işaretli. Geçmiş ve çerezler için sizin onayınız gerekir."
          }
        }
      }
    },
