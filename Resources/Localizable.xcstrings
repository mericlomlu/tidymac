    },
    "Clean Selected Items…": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçili Öğeleri Temizle…"
          }
        }
      }
    },
    "Cleaning…": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temizleniyor…"
          }
        }
      }
    },
    "Cleans will then move items to the Trash. You still confirm each clean before anything is removed, and dry run comes back on the next time TidyMac opens.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bundan sonra temizlikler öğeleri Çöp Sepeti'ne taşır. Bir şey kaldırılmadan önce her temizliği yine siz onaylarsınız ve TidyMac bir sonraki açılışında deneme modu yeniden açılır."
          }
        }
      }
    },
    "Cleanup": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temizlik"
          }
        }
      }
    },
    "Click a folder to drill in. Right-click a block to reveal it in Finder. Disk Map is read-only.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçine girmek için bir klasöre tıklayın. Finder'da göstermek için bir bloğa sağ tıklayın. Disk Haritası salt okunurdur."
          }
        }
      }
    },
    "Comparing files takes a few minutes": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyaları karşılaştırmak birkaç dakika sürer"
          }
        }
      }
    },
    "Comparing files…": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
